ENVIRONMENT=development
APP_VERSION=0.1.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8000

DATABASE_URL=sqlite:///./data/saocs.db

JWT_SECRET_KEY=replace-with-a-secure-random-64-character-jwt-signing-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

WIFI_SSID=your-wifi-or-hotspot-ssid
WIFI_PASSWORD=your-wifi-or-hotspot-password

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_BACKEND_USER=saocs_backend
MQTT_BACKEND_PASSWORD=replace-with-secure-backend-mqtt-password
MQTT_DEVICE_USER=saocs_esp32
MQTT_DEVICE_PASSWORD=replace-with-secure-device-mqtt-password
MQTT_DEFAULT_DEVICE_ID=esp32_prototype_01

TARIFF_RATE_PER_KWH=209.5

OTA_PASSWORD=replace-with-secure-esp32-ota-password

DUCKDNS_DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token
OCI_STATIC_IP=your-oci-vm-reserved-static-ip
