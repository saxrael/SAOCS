# Smart Office Appliance Control System (SAOCS) — Environment Configuration Template
#
# Instructions:
# Copy this file to '.env' on your local development machine or production VPS:
#   cp .env.template .env
# Populate all placeholder values with your actual configuration and credentials.
#
# Security rule:
# Never commit the actual '.env' file or any plaintext secrets to source control.
# The coding agent is explicitly barred from creating, reading, or editing '.env'.
# Maintain this template (.env.template) only.

# Application Runtime & Server Settings
ENVIRONMENT=development
APP_VERSION=0.1.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8000

# Database (SQLite)
DATABASE_URL=sqlite:///./data/saocs.db

# Security & JWT Authentication
# Generate a secure 64-char key: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-jwt-signing-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (Account Verification)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# MQTT Message Broker (Mosquitto 2.x)
MQTT_BROKER_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_BACKEND_USER=saocs_backend
MQTT_BACKEND_PASSWORD=replace-with-secure-backend-mqtt-password
MQTT_DEVICE_USER=saocs_esp32
MQTT_DEVICE_PASSWORD=replace-with-secure-device-mqtt-password
MQTT_DEFAULT_DEVICE_ID=esp32_prototype_01

# Electricity Tariff & Energy Analytics
# Kaduna Electric Band A tariff (default: ₦209.5/kWh)
TARIFF_RATE_PER_KWH=209.5

# Firmware & ArduinoOTA (ESP32)
OTA_PASSWORD=replace-with-secure-esp32-ota-password

# Production Domain & Hosting (OCI VPS / DuckDNS / Caddy)
DUCKDNS_DOMAIN=your-subdomain.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token
OCI_STATIC_IP=your-oci-vm-reserved-static-ip
