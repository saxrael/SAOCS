# ==============================================================================
# Smart Office Appliance Control System (SAOCS) - .gitignore
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit .env)
.env
.env.*
!.env.template
*.pem
*.key
*.cert
*.crt
id_rsa*

# PlatformIO & Embedded Firmware
.pio/
.pioenvs/
.piolibdeps/

# Python & Backend (FastAPI, uv)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
env/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node & Frontend (React, Vite)
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/

# Database & Persistent Volumes
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
data/

# OS and Editor Metadata
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Skill Installer Sandbox Guard
_skill_dl_*
